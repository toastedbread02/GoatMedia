# GoatMedia configuration
# Copy to .env and adjust. All values have sensible defaults for local development.

# Port for the API / production server
PORT=3001

# Public origin used in password-reset links and origin checks.
APP_ORIGIN=http://localhost:5173

# Where SQLite lives and where private uploads are stored (outside dist/).
DATA_DIR=.data

# Upload limits (also sent to the browser through /api/config)
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=180
MIN_DURATION_SECONDS=2
MAX_AVATAR_MB=4

# Manual moderation is the product rule. Keep this off; there is no automatic approval.
AUTO_APPROVE=false

# Set to "1" to let the password-reset endpoint return the reset link in its
# response during local development (no email service configured).
DEV_EXPOSE_RESET_LINK=1

# Password-reset email delivery. Without these, reset links are only written to
# the server log — workable locally, not workable for the public site.
# Any provider with a Resend-compatible POST /emails endpoint works.
EMAIL_API_KEY=
EMAIL_FROM="GoatMedia <no-reply@your-domain.example>"
# EMAIL_API_URL=https://api.resend.com/emails
