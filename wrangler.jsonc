{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "goatmedia-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "observability": { "enabled": true },
  "vars": {
    // goatmedia.js.org is allowed ahead of time so the site works the moment
    // the domain starts serving. The old Pages origin stays until links fade.
    "ALLOWED_ORIGINS": "https://goatmedia.is-a.dev,https://toastedbread02.github.io,http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goatmedia",
      "database_id": "99f990ab-4246-4b49-9353-9269a5ccd115",
      "migrations_dir": "migrations"
    }
  ]
}
