{
  "name": "goatmedia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "GoatMedia — a goat photo network with human moderation.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "api:check": "tsx scripts/api-check.ts",
    "deploy:api": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply goatmedia --remote",
    "db:migrate:local": "wrangler d1 migrations apply goatmedia --local"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.158.0"
  }
}
